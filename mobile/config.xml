<?xml version="1.0" encoding="utf-8"?>
<widget id="com.ericguerra.ridematch" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>RideMatch</name>
  <description>Campus ride sharing</description>
  <content src="index.html"/>
  <access origin="*"/>
  <preference name="Orientation" value="portrait"/>
  <preference name="SplashScreenDelay" value="1500"/>
  <plugin name="cordova-plugin-geolocation" spec="^4.1.0"/>
  <plugin name="cordova-plugin-whitelist" spec="^1.3.5"/>
  <platform name="android">
    <allow-intent href="market:*"/>
  </platform>
  <platform name="ios">
    <edit-config file="*-Info.plist" mode="merge" target="NSLocationWhenInUseUsageDescription">
      <string>RideMatch uses your location to suggest a pickup point.</string>
    </edit-config>
  </platform>
</widget>
